{
  "name": "nbl-archiver",
  "version": "1.0.0",
  "description": "NBL Database Archiving Scheduler — moves historical data from neuralbyt to neuralbyt_archive.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage:run": "vitest run --coverage",
    "test:coverage:open": "npx opn-cli coverage/index.html",
    "test:coverage": "npm-run-all -s test:coverage:run test:coverage:open"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "msnodesqlv8": "^5.1.1",
    "mssql": "^11.0.1",
    "node-schedule": "^2.1.1",
    "nodemailer": "^7.0.6",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "c8": "^10.1.3",
    "npm-run-all": "^4.1.5",
    "opn-cli": "^4.1.0",
    "vitest": "^3.2.4"
  },
  "imports": {
    "#dblayer/*": "./src/dblayer/*",
    "#common/*": "./src/common/*",
    "#schedulers/*": "./src/schedulers/*"
  }
}
